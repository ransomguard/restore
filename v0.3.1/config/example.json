{
  "schema_version": 1,
  "network": {
    "scope": "host_outbound",
    "jev_url": "https://api.typesafe.ai",
    "extra_https_targets": []
  },
  "decision": {
    "mode": "live_opt_in_or_simulation",
    "thresholds_are_demo_only": true,
    "benign_threshold": 0.2,
    "malicious_threshold": 0.8
  },
  "recovery": {
    "protected_root": "C:\\RansomGuardLab\\Protected",
    "volume_root": "C:\\",
    "snapshot_policy": "hourly_only",
    "snapshot_interval_seconds": 3600,
    "snapshot_creation_triggers": [
      "hourly_schedule"
    ],
    "snapshot_selection_policy": "existing_same_volume_before_incident",
    "missing_snapshot_action": "report_recovery_unavailable"
  },
  "triage": {
    "window_seconds": 10.0,
    "cooldown_seconds": 30.0,
    "max_processes": 1024,
    "max_events_per_process": 256,
    "max_paths_per_process": 8
  }
}
